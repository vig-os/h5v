# ===============================================================================
# PROJECT RECIPES - Team-shared customizations
# This file is git-tracked and preserved during devcontainer upgrades.
# Add team-shared recipes here that everyone on the project should use.
# ===============================================================================
# ===============================================================================
# PROJECT VARIABLES
# ===============================================================================

project := "h5v"
# ===============================================================================
# INFO
# ===============================================================================

# Show project information
[group('info')]
info:
    @echo "Project: {{ project }}"

# -------------------------------------------------------------------------------
# CODE QUALITY
# -------------------------------------------------------------------------------

# Run all linters (Python + Rust)
[group('quality')]
lint:
    @if [ -f pyproject.toml ]; then uv run ruff check .; fi
    @if [ -f Cargo.toml ]; then cargo clippy --workspace --all-targets; fi

# Format code (Python + Rust)
[group('quality')]
format:
    @if [ -f pyproject.toml ]; then uv run ruff format .; fi
    @if [ -f Cargo.toml ]; then cargo fmt --all; fi

# Run pre-commit hooks on all files
[group('quality')]
precommit:
    prek run --all-files

# -------------------------------------------------------------------------------
# TESTING
# -------------------------------------------------------------------------------

# Run the full test suite (Python + Rust)
[group('test')]
test *args:
    @just test-py {{ args }}
    @just test-rs

# Run Python tests (exit 5 = "no tests collected" is a no-op, not a failure)
[group('test')]
test-py *args:
    @if [ -f pyproject.toml ]; then uv run pytest {{ args }} || { rc=$?; [ "$rc" -eq 5 ] || exit "$rc"; }; fi

# Single-threaded because the HDF5 C library this links is not built
# thread-safe: parallel test threads race on the file lock (see the note at the
# top of crates/fd5/tests/conformance.rs). The default scope skips integration
# test targets, so the fd5 conformance suite is NOT run — it needs fixtures from
# tests/conformance/generate_fixtures.py, which this workspace does not carry
# yet. Once those land, drop `--lib --bins` (or run `just test-rs --workspace`).
# Run Rust tests
[group('test')]
test-rs *args="--workspace --lib --bins":
    @if [ -f Cargo.toml ]; then cargo test {{ args }} -- --test-threads=1; fi

# Run tests with coverage (exit 5 = "no tests collected" is a no-op, not a failure)
[group('test')]
test-cov *args:
    @if [ -f pyproject.toml ]; then uv run pytest --cov --cov-report=term-missing {{ args }} || { rc=$?; [ "$rc" -eq 5 ] || exit "$rc"; }; fi

# -------------------------------------------------------------------------------
# DEPENDENCIES
# -------------------------------------------------------------------------------

# NOTE: extras are NOT opt-in here (unlike the devkit template): pytest lives
# in the `dev` extra, so `just test` needs --all-extras.
# Sync all dependencies (idempotent, fast if nothing changed)
[group('deps')]
sync *args="--all-extras --all-groups":
    @if [ -f pyproject.toml ]; then uv sync {{ args }}; fi
    @if [ -f Cargo.toml ]; then cargo fetch --locked; fi

# Update all dependencies
[group('deps')]
update:
    @if [ -f pyproject.toml ]; then uv lock --upgrade; fi
    @if [ -f Cargo.toml ]; then cargo update; fi
    @just sync

# -------------------------------------------------------------------------------
# BUILD
# -------------------------------------------------------------------------------

# Clean build artifacts
[group('build')]
clean-artifacts:
    rm -rf .pytest_cache .ruff_cache .coverage htmlcov dist build *.egg-info
    find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

# -------------------------------------------------------------------------------
# GIT
# -------------------------------------------------------------------------------

# Pretty one-line git log (last 20 commits)
[group('git')]
log:
    git log --oneline -20

# Show current branch + list recent branches
[group('git')]
branch:
    #!/usr/bin/env bash
    echo "Current: $(git branch --show-current)"
    echo ""
    echo "Recent branches:"
    git branch -a | head -15

# ===============================================================================
# PROJECT-SPECIFIC RECIPES
# ===============================================================================
# Uncomment and customize for your project:
# # Run the application
# [group('app')]
# run *args:
#     uv run python -m {{project}} {{args}}
# # Run database migrations (if using sidecar)
# [group('app')]
# migrate:
#     just sidecar postgres migrate
#
# # Prepare release branch (manual workflow dispatch helper)
# [group('release')]
# prepare-release version:
#     gh workflow run prepare-release.yml --ref main -f "version={{ version }}"
#
# # Finalize and publish release (manual workflow dispatch helper)
# [group('release')]
# finalize-release version:
#     gh workflow run release.yml --ref release/{{ version }} -f "version={{ version }}" -f "release-kind=final" -f "dry-run=false"
#
# # Publish candidate release (manual workflow dispatch helper)
# [group('release')]
# publish-candidate version:
#     gh workflow run release.yml --ref release/{{ version }} -f "version={{ version }}" -f "release-kind=candidate" -f "dry-run=false"
